#include <winver.h>
1 ICON "nhl_hitz_2003.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @HITZ_FILE_VERSION@,0
 PRODUCTVERSION @HITZ_FILE_VERSION@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "dalves408/nhlhitz2003recomp"
   VALUE "FileDescription", "NHL Hitz 2003 settings"
   VALUE "FileVersion", "@HITZ_PACKAGE_VERSION@.0"
   VALUE "InternalName", "config"
   VALUE "OriginalFilename", "config.exe"
   VALUE "ProductName", "NHL Hitz 2003"
   VALUE "ProductVersion", "@HITZ_PACKAGE_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
