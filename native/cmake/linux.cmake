set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
add_compile_definitions(_GNU_SOURCE)
# Guest RAM is reinterpreted at several widths, and Xbox integer operations
# wrap. Preserve those semantics under GCC/Clang optimization.
add_compile_options(-fno-strict-aliasing -fwrapv -ffp-contract=off)
set(XBOXRECOMP_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../tools/xboxrecomp" CACHE PATH "Toolkit source")
find_package(SDL2 REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(EPOXY REQUIRED IMPORTED_TARGET epoxy)
add_subdirectory(${XBOXRECOMP_DIR} ${CMAKE_BINARY_DIR}/xboxrecomp)

function(hitz_linux_overrides target)
    get_target_property(sources ${target} SOURCES)
    foreach(name IN LISTS ARGN)
        list(REMOVE_ITEM sources ${name})
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
    foreach(name IN LISTS ARGN)
        target_sources(${target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/overrides/${name}")
    endforeach()
endfunction()
hitz_linux_overrides(platform win32_compat.c)
target_include_directories(platform PRIVATE "${XBOXRECOMP_DIR}/src/platform")
hitz_linux_overrides(xbox_kernel nv2a_pb_exec.c nv2a_pb_scan.c nv2a_vsh_interp.c
    nv2a_combiner.c kernel_bridge.c kernel_hal.c xbox_memory_layout.c kernel_path.c kernel_file.c)
hitz_linux_overrides(host_time host_time.c)
hitz_linux_overrides(xbox_usb usb_gamepad.c ohci.c)
hitz_linux_overrides(xbox_input keyboard.c)
target_include_directories(xbox_input PRIVATE "${XBOXRECOMP_DIR}/src/input")
target_include_directories(host_time PRIVATE "${XBOXRECOMP_DIR}/src/platform")
target_include_directories(xbox_usb PRIVATE "${XBOXRECOMP_DIR}/src/usb")
target_include_directories(xbox_kernel PRIVATE "${XBOXRECOMP_DIR}/src")

file(GLOB RECOMP_GEN_SOURCES CONFIGURE_DEPENDS "src/recomp/gen/*.c")
set(nis_definition "void sub_00147AE0(void)\n{")
foreach(nis_generated IN LISTS RECOMP_GEN_SOURCES)
    file(READ "${nis_generated}" nis_source)
    string(FIND "${nis_source}" "${nis_definition}" nis_position)
    if(NOT nis_position EQUAL -1)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${nis_generated}")
        string(REPLACE "${nis_definition}" "void hitz_original_00147AE0(void)\n{" nis_source "${nis_source}")
        set(nis_previous "")
        if(EXISTS "${CMAKE_CURRENT_BINARY_DIR}/recomp_nis.c")
            file(READ "${CMAKE_CURRENT_BINARY_DIR}/recomp_nis.c" nis_previous)
        endif()
        if(NOT nis_previous STREQUAL nis_source)
            file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/recomp_nis.c" "${nis_source}")
        endif()
        list(REMOVE_ITEM RECOMP_GEN_SOURCES "${nis_generated}")
        list(APPEND RECOMP_GEN_SOURCES "${CMAKE_CURRENT_BINARY_DIR}/recomp_nis.c")
        break()
    endif()
endforeach()
set(unresolved_generated "${CMAKE_CURRENT_SOURCE_DIR}/src/recomp/gen/recomp_stubs_unresolved.c")
if(EXISTS "${unresolved_generated}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${unresolved_generated}")
    file(READ "${unresolved_generated}" unresolved_source)
    set(stub_macro "#define RECOMP_STUB_HIT(va) do { static int _seen;")
    string(FIND "${unresolved_source}" "${stub_macro}" stub_position)
    if(stub_position EQUAL -1)
        message(FATAL_ERROR "Unrecognized unresolved-stub template; review strict Linux dispatch")
    endif()
    string(REPLACE "${stub_macro}" "#define RECOMP_STUB_HIT(va) do { hitz_unresolved_target(va); static int _seen;" unresolved_source "${unresolved_source}")
    string(PREPEND unresolved_source "#include <stdint.h>\nextern void hitz_unresolved_target(uint32_t);\n")
    set(unresolved_previous "")
    if(EXISTS "${CMAKE_CURRENT_BINARY_DIR}/recomp_unresolved.c")
        file(READ "${CMAKE_CURRENT_BINARY_DIR}/recomp_unresolved.c" unresolved_previous)
    endif()
    if(NOT unresolved_previous STREQUAL unresolved_source)
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/recomp_unresolved.c" "${unresolved_source}")
    endif()
    list(REMOVE_ITEM RECOMP_GEN_SOURCES "${unresolved_generated}")
    list(APPEND RECOMP_GEN_SOURCES "${CMAKE_CURRENT_BINARY_DIR}/recomp_unresolved.c")
endif()
set(HITZ_GUEST_OPT_LEVEL "2" CACHE STRING "Generated guest optimization: 0 for quick bring-up, 2 for normal play")
if(NOT HITZ_GUEST_OPT_LEVEL MATCHES "^[0123]$")
    message(FATAL_ERROR "HITZ_GUEST_OPT_LEVEL must be 0, 1, 2 or 3")
endif()
if(RECOMP_GEN_SOURCES)
    # Keep generated translation units affordable on hosts with limited RAM.
    # Line tables retain symbolic crash locations without full variable debug data.
    set_source_files_properties(${RECOMP_GEN_SOURCES} PROPERTIES COMPILE_OPTIONS "-O${HITZ_GUEST_OPT_LEVEL};-g1")
endif()
add_executable(${PROJECT_NAME} src/main_linux.c src/backend_gl.c src/mmio_linux.c src/filesystem_linux.c
    src/recomp_manual.c src/hitz_nis.c ${RECOMP_GEN_SOURCES})
set_source_files_properties(src/main_linux.c PROPERTIES
    COMPILE_DEFINITIONS "HITZ_GUEST_OPT_LEVEL=${HITZ_GUEST_OPT_LEVEL}")
target_include_directories(${PROJECT_NAME} PRIVATE src src/recomp src/recomp/gen
    "${XBOXRECOMP_DIR}/include" "${XBOXRECOMP_DIR}/src/kernel")
target_link_libraries(${PROJECT_NAME} PRIVATE xboxrecomp SDL2::SDL2 PkgConfig::EPOXY)
target_compile_definitions(${PROJECT_NAME} PRIVATE _GNU_SOURCE
    HITZ_SHADER_DIR="${CMAKE_CURRENT_SOURCE_DIR}/src/shaders")
target_compile_options(${PROJECT_NAME} PRIVATE -g -fno-omit-frame-pointer)
target_link_options(${PROJECT_NAME} PRIVATE -rdynamic)
find_program(HITZ_LLD NAMES ld.lld)
if(HITZ_LLD)
    target_link_options(${PROJECT_NAME} PRIVATE -fuse-ld=lld)
endif()

