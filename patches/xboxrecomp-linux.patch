+/* RECOMP_APU_I3DL2_DRY=<gain>: how much of the I3DL2 reverb send (bin 10)
+ * the stub mixdown passes dry. Default 0, there being no reverb DSP; 1
+ * restores the old mixdown. */
+static float mcpx_apu_i3dl2_dry(void)
+{
+    static float g = -1.0f;
+    if (g < 0.0f) {
+        const char *e = getenv("RECOMP_APU_I3DL2_DRY");
+        g = (e && *e) ? (float)atof(e) : 0.0f;
+        if (g < 0.0f) g = 0.0f;
+    }
+    return g;
+}
