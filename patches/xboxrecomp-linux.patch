@@ -164,9 +164,20 @@ int xa2_is_active(void)
 /* Hand one EP period to the queue. SDL copies the samples, so the caller's
  * buffer is free on return. Nothing is ever refused by depth: the queue is
  * unbounded and pacing by queue depth holds it at the marks. */
+/* NHL Hitz 2003 (JOJO item 27): the F1 / quit overlays mute the output, as
+ * xa2_set_muted() does on Windows (master volume 0). The queue keeps being fed
+ * at the same rate, with silence, so the APU's pacing and state are untouched. */
+static volatile int g_muted;
+void xa2_set_muted(int muted) { g_muted = muted != 0; }
+
 int xa2_submit_samples(const int16_t *samples, int num_samples)
 {
+    static int16_t *zero; static int zero_n;
     if (!g_initialized || !g_dev || num_samples <= 0) return 0;
+    if (g_muted) {
+        if (zero_n < num_samples) { free(zero); zero = calloc((size_t)num_samples * SDLA_CHANNELS, sizeof *zero); zero_n = zero ? num_samples : 0; }
+        if (zero) samples = zero;
+    }
     if (SDL_QueueAudio(g_dev, samples,
                        (Uint32)num_samples * SDLA_CHANNELS * sizeof(int16_t)) != 0) {
         fprintf(stderr, "[SDL2] SDL_QueueAudio failed: %s\n", SDL_GetError());
diff --git a/src/input/xinput_device.c b/src/input/xinput_device.c
index 5975014..3ea213b 100644
--- a/src/input/xinput_device.c
+++ b/src/input/xinput_device.c
@@ -176,6 +176,8 @@ DWORD xbox_InputGetCapabilities(DWORD dwPort, DWORD dwFlags, XBOX_INPUT_CAPABILI
 /* ======================================================================== */
 
 #include <SDL.h>
+#include <stdio.h>
+#include <stdlib.h>
 
 static SDL_GameController *g_pads[XBOX_MAX_CONTROLLERS];
 static BOOL  g_controller_connected[XBOX_MAX_CONTROLLERS];
@@ -296,12 +298,43 @@ DWORD xbox_InputSetState(DWORD dwPort, const XBOX_VIBRATION *pVibration)
         return ERROR_DEVICE_NOT_CONNECTED;
 
     SDL_GameController *c = g_pads[dwPort];
-    if (!c) return ERROR_DEVICE_NOT_CONNECTED;
+    static int log = -1, logged;
+    if (log < 0) { const char *e = getenv("RECOMP_RUMBLE_LOG"); log = e && *e == '1'; }
+    if (!c) {
+        if (log && logged < 50) { logged++; fprintf(stderr, "[RUMBLE] pad %lu %u/%u: no controller open\n",
+            (unsigned long)dwPort, pVibration->wLeftMotorSpeed, pVibration->wRightMotorSpeed); }
+        return ERROR_DEVICE_NOT_CONNECTED;
+    }
 
-    /* SDL rumble needs a duration; refresh for ~1s on each call (the game
-     * polls vibration continuously). */
-    SDL_GameControllerRumble(c, pVibration->wLeftMotorSpeed,
-                             pVibration->wRightMotorSpeed, 1000);
+    /* XInput keeps the motors at the last values until they change; a title
+     * may send a value once and stop. SDL needs a duration, so hold it for the
+     * longest SDL allows (about 65 s) and re-send on every report. */
+    {
+        /* Hitz pulses both motors at 0xFFFF and stops them a few frames
+         * later. An Xbox One pad's motors barely spin up in that time, so
+         * a stop that lands sooner than RECOMP_RUMBLE_MIN_MS (default 250)
+         * after the start becomes a short timed rumble: SDL ends it itself. */
+        static Uint32 on_at[XBOX_MAX_CONTROLLERS];
+        static int min_ms = -1;
+        if (min_ms < 0) { const char *e = getenv("RECOMP_RUMBLE_MIN_MS"); min_ms = e ? atoi(e) : 250; if (min_ms < 0) min_ms = 0; }
+        Uint32 now = SDL_GetTicks();
+        Uint16 lo = pVibration->wLeftMotorSpeed, hi = pVibration->wRightMotorSpeed;
+        Uint32 dur = 0xFFFF;
+        int held = 0;
+        if (lo || hi) {
+            on_at[dwPort] = now ? now : 1;
+        } else if (on_at[dwPort] && now - on_at[dwPort] < (Uint32)min_ms) {
+            dur = (Uint32)min_ms - (now - on_at[dwPort]);
+            held = 1; on_at[dwPort] = 0;
+            lo = hi = 0xFFFF; /* Hitz only ever uses full strength */
+        } else {
+            on_at[dwPort] = 0;
+        }
+        int rc = SDL_GameControllerRumble(c, lo, hi, dur);
+        if (log && logged < 2000) { logged++; fprintf(stderr, "[RUMBLE] t=%u pad %lu left %u right %u%s rc %d%s%s\n",
+            now, (unsigned long)dwPort, pVibration->wLeftMotorSpeed, pVibration->wRightMotorSpeed,
+            held ? " (stop deferred)" : "", rc, rc ? " " : "", rc ? SDL_GetError() : ""); }
+    }
     return ERROR_SUCCESS;
